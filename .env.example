# Modèle des variables d'environnement d'AVERO.
# Copie ce fichier en ".env" et remplis les valeurs : ".env" n'est jamais enregistré dans git.

# Supabase → Project Settings → Database → Connection string
# Application : pooler « Transaction » (port 6543), terminer par ?pgbouncer=true
DATABASE_URL=
# Migrations : connexion « Session » (port 5432)
DIRECT_URL=

# Better Auth : clé secrète (générée avec « openssl rand -base64 32 ») et adresse de l'application
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connexion des réseaux : "simulated" (écran d'autorisation simulé, sans compte développeur)
# ou "real" (vraies API Meta et TikTok, clés ci-dessous obligatoires). Absent = simulated.
OAUTH2_MODE=simulated
# Adresse publique de l'application (sert aux adresses de retour OAuth)
APP_URL=http://localhost:3000
# Clé de chiffrement des jetons Instagram/TikTok (générée avec « openssl rand -base64 32 »)
TOKEN_ENCRYPTION_KEY=

# Mode réel uniquement : app Meta (Instagram API with Instagram Login) et app TikTok (Login Kit)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Comptes de test (facultatif) : identifiants des comptes créateur et marque de démonstration
AVERO_CREATOR_EMAIL=
AVERO_CREATOR_PASSWORD=
AVERO_BRAND_EMAIL=
AVERO_BRAND_PASSWORD=
